# ===== Firebase (required for real login/signup on public site) =====
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Comma-separated emails that get admin role on first login/signup
VITE_ADMIN_EMAILS=admin@thecodevibe.io

# ===== Backend API (optional) =====
# Empty = no backend / Netlify-only mode (forms use email fallback)
VITE_API_BASE_URL=

# ===== Contact form email (REQUIRED for Netlify-only) =====
# Form submissions go to this address via FormSubmit.co
VITE_CONTACT_EMAIL=your-email@gmail.com
